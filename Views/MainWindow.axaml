<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:OrbitalDocking.ViewModels"
        xmlns:vmp="using:OrbitalDocking.ViewModels.Pages"
        xmlns:c="using:OrbitalDocking.Controls"
        xmlns:conv="using:OrbitalDocking.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
        x:Class="OrbitalDocking.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Orbital Docking"
        Width="1280" Height="800"
        MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundColor}">

    <Grid RowDefinitions="*,Auto">
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*">

            <!-- Sidebar: full width with labels, or an icon rail when collapsed -->
            <Border Grid.Column="0"
                    Classes="sidebar"
                    Classes.collapsed="{Binding IsSidebarCollapsed}"
                    Background="{DynamicResource SurfaceColor}"
                    BorderBrush="{DynamicResource BorderColor}"
                    BorderThickness="0,0,1,0">
                <DockPanel Margin="12,16">
                    <Grid DockPanel.Dock="Top" Classes="nav-row" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
                        <TextBlock Grid.Column="0" Classes="nav-text"
                                   Text="Orbital"
                                   FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryColor}"
                                   VerticalAlignment="Center"
                                   Margin="10,0,0,0"/>
                        <Button Grid.Column="1" Classes="icon" Command="{Binding ToggleSidebarCommand}" ToolTip.Tip="Toggle sidebar">
                            <Panel>
                                <c:Icon Data="{StaticResource Icon.PanelLeftClose}" IsVisible="{Binding !IsSidebarCollapsed}"/>
                                <c:Icon Data="{StaticResource Icon.PanelLeftOpen}" IsVisible="{Binding IsSidebarCollapsed}"/>
                            </Panel>
                        </Button>
                    </Grid>

                    <Button DockPanel.Dock="Bottom"
                            Classes="nav-footer"
                            Classes.active="{Binding IsSettingsActive}"
                            Command="{Binding ShowSettingsCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <c:Icon Data="{StaticResource Icon.Settings}"/>
                            <TextBlock Classes="nav-text" Text="Settings" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <ListBox Classes="nav"
                             ItemsSource="{Binding Pages}"
                             SelectedItem="{Binding SelectedNavPage}">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="vmp:PageViewModel">
                                <Grid Classes="nav-row" ColumnDefinitions="Auto,*,Auto">
                                    <c:Icon Grid.Column="0"
                                            Data="{Binding IconKey, Converter={x:Static conv:IconKeyConverter.Instance}}"/>
                                    <TextBlock Grid.Column="1" Classes="nav-text" Text="{Binding Title}" FontSize="13" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                    <Panel Grid.Column="2" Classes="nav-extra">
                                        <Border Classes="badge"
                                                IsVisible="{Binding Count, Converter={x:Static ObjectConverters.IsNotNull}}">
                                            <TextBlock Text="{Binding Count}"/>
                                        </Border>
                                    </Panel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Current page -->
            <ContentControl Grid.Column="1" Content="{Binding CurrentPage}"/>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="1"
                Background="{DynamicResource SurfaceColor}"
                BorderBrush="{DynamicResource BorderColor}"
                BorderThickness="0,1,0,0"
                Height="30">
            <Grid Margin="16,0" ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="Docker" Classes="label" FontSize="10" VerticalAlignment="Center"/>
                    <TextBlock Classes="docker"
                               Classes.online="{Binding State.IsDockerConnected}"
                               Classes.connecting="{Binding State.IsDockerConnecting}"
                               Text="{Binding State.DockerVersion}"/>
                </StackPanel>

                <TextBlock Grid.Column="1"
                           Text="{Binding State.StatusMessage}"
                           FontSize="11"
                           Foreground="{DynamicResource TextTertiaryColor}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                    <Button Classes="ghost tint-primary" FontSize="11" Padding="6,2"
                            IsVisible="{Binding State.IsUpdateAvailable}"
                            Content="{Binding State.UpdateLabel}"
                            Command="{Binding Settings.OpenReleaseCommand}"
                            ToolTip.Tip="Open the release on GitHub"/>
                    <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryColor}"
                               Text="{Binding Containers.RunningCount, StringFormat='{}{0} running'}"/>
                    <TextBlock FontSize="11" Foreground="{DynamicResource TextTertiaryColor}"
                               Text="{Binding Containers.StoppedCount, StringFormat='{}{0} stopped'}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
