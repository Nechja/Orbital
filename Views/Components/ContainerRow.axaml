<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OrbitalDocking.ViewModels"
             xmlns:vmp="using:OrbitalDocking.ViewModels.Pages"
             xmlns:pages="using:OrbitalDocking.Views.Pages"
             xmlns:c="using:OrbitalDocking.Controls"
             x:Class="OrbitalDocking.Views.Components.ContainerRow"
             x:DataType="vm:ContainerViewModel">

    <!-- The whole row is a button that selects the container for the detail pane. -->
    <Button Classes="row"
            Classes.selected="{Binding IsSelected}"
            Command="{Binding $parent[pages:ContainersPageView].((vmp:ContainersPageViewModel)DataContext).SelectCommand}"
            CommandParameter="{Binding}">
        <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" Height="54" Margin="16,0,8,0">

            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                <TextBlock Text="{Binding Name}"
                           FontSize="13" FontWeight="Medium"
                           Foreground="{DynamicResource TextPrimaryColor}"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding Image}"
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondaryColor}"
                           TextTrimming="CharacterEllipsis"/>
            </StackPanel>

            <Border Grid.Column="1" Classes="pill"
                    Classes.running="{Binding IsRunning}"
                    Classes.paused="{Binding IsPaused}"
                    Classes.problem="{Binding IsProblematic}"
                    Margin="0,0,16,0">
                <TextBlock Text="{Binding StateLabel}"/>
            </Border>

            <TextBlock Grid.Column="2"
                       Text="{Binding Status}"
                       FontSize="12"
                       Foreground="{DynamicResource TextSecondaryColor}"
                       VerticalAlignment="Center"
                       MinWidth="170"
                       Margin="0,0,12,0"/>

            <StackPanel Grid.Column="3" Classes="row-actions" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                <Button Classes="icon tint-primary" ToolTip.Tip="Start" IsVisible="{Binding IsStopped}"
                        Command="{Binding $parent[pages:ContainersPageView].((vmp:ContainersPageViewModel)DataContext).StartContainerCommand}"
                        CommandParameter="{Binding}">
                    <c:Icon Data="{StaticResource Icon.Play}"/>
                </Button>
                <Button Classes="icon tint-danger" ToolTip.Tip="Stop" IsVisible="{Binding IsRunning}"
                        Command="{Binding $parent[pages:ContainersPageView].((vmp:ContainersPageViewModel)DataContext).StopContainerCommand}"
                        CommandParameter="{Binding}">
                    <c:Icon Data="{StaticResource Icon.Square}"/>
                </Button>
                <Button Classes="icon tint-restart" ToolTip.Tip="Restart" IsVisible="{Binding IsRunning}"
                        Command="{Binding $parent[pages:ContainersPageView].((vmp:ContainersPageViewModel)DataContext).RestartContainerCommand}"
                        CommandParameter="{Binding}">
                    <c:Icon Data="{StaticResource Icon.RotateCw}"/>
                </Button>
                <Button Classes="icon tint-accent" ToolTip.Tip="Logs"
                        Command="{Binding $parent[pages:ContainersPageView].((vmp:ContainersPageViewModel)DataContext).ShowLogsCommand}"
                        CommandParameter="{Binding}">
                    <c:Icon Data="{StaticResource Icon.ScrollText}"/>
                </Button>
            </StackPanel>

            <Button Grid.Column="4" Classes="icon" ToolTip.Tip="More" VerticalAlignment="Center">
                <Button.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                        <MenuItem Header="View logs"
                                  Command="{Binding $parent[pages:ContainersPageView].((vmp:ContainersPageViewModel)DataContext).ShowLogsCommand}"
                                  CommandParameter="{Binding}"/>
                        <Separator/>
                        <MenuItem Header="Remove container" Classes="danger"
                                  IsEnabled="{Binding CanRemove}"
                                  Command="{Binding $parent[pages:ContainersPageView].((vmp:ContainersPageViewModel)DataContext).RemoveContainerCommand}"
                                  CommandParameter="{Binding}"/>
                    </MenuFlyout>
                </Button.Flyout>
                <c:Icon Data="{StaticResource Icon.EllipsisVertical}"/>
            </Button>
        </Grid>
    </Button>
</UserControl>
