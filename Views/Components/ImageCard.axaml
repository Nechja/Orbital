<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:OrbitalDocking.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="120"
             x:Class="OrbitalDocking.Views.Components.ImageCard"
             x:DataType="vm:ImageViewModel">
    
    <Border Background="{DynamicResource SurfaceColor}"
            BorderBrush="{DynamicResource BorderColor}"
            BorderThickness="1"
            CornerRadius="6"
            Padding="20"
            Margin="0,4">
        <Grid ColumnDefinitions="Auto,*,Auto">
            <StackPanel Grid.Column="0" Spacing="8" MinWidth="200" MaxWidth="400">
                <TextBlock Text="{Binding ShortRepository}"
                           FontSize="14"
                           Foreground="{DynamicResource TextPrimaryColor}"
                           ToolTip.Tip="{Binding Repository}"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding Tag}"
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondaryColor}"
                           TextTrimming="CharacterEllipsis"/>
            </StackPanel>

            <StackPanel Grid.Column="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="8">
                <TextBlock Text="{Binding SizeFormatted}"
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondaryColor}"
                           HorizontalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding CreatedRelative}"
                           FontSize="11"
                           Foreground="{DynamicResource TextTertiaryColor}"
                           HorizontalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
            </StackPanel>

            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center">

                <!-- Full buttons (visible when not compact) -->
                <StackPanel Orientation="Horizontal"
                            Spacing="8"
                            IsVisible="{Binding !IsCompactMode}">
                    <Button Classes="primary"
                            Content="RUN"
                            Name="RunButton"/>
                    <Button Classes="danger"
                            Content="REMOVE"
                            Name="RemoveButton"/>
                    <Button Classes="accent"
                            Content="PULL"
                            Name="PullButton"/>
                </StackPanel>

                <!-- Compact menu (visible when compact) -->
                <Button Background="Transparent"
                        BorderThickness="0"
                        Padding="8"
                        Cursor="Hand"
                        IsVisible="{Binding IsCompactMode}"
                        Name="CompactMenuButton">
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <MenuItem Header="RUN"
                                      Name="MenuRunButton">
                                <MenuItem.Icon>
                                    <TextBlock Text="▶" Foreground="{DynamicResource PrimaryColor}"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="PULL"
                                      Name="MenuPullButton">
                                <MenuItem.Icon>
                                    <TextBlock Text="⬇" Foreground="{DynamicResource ActionAccentColor}"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator/>
                            <MenuItem Header="REMOVE"
                                      Name="MenuRemoveButton">
                                <MenuItem.Icon>
                                    <TextBlock Text="🗑" Foreground="{DynamicResource DangerColor}"/>
                                </MenuItem.Icon>
                            </MenuItem>
                        </MenuFlyout>
                    </Button.Flyout>
                    <TextBlock Text="⋮"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextSecondaryColor}"/>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>