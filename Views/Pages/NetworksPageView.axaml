<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OrbitalDocking.ViewModels"
             xmlns:vmp="using:OrbitalDocking.ViewModels.Pages"
             xmlns:conv="using:OrbitalDocking.Converters"
             xmlns:c="using:OrbitalDocking.Controls"
             x:Class="OrbitalDocking.Views.Pages.NetworksPageView"
             x:DataType="vmp:NetworksPageViewModel">

    <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="32,24,32,16">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,12">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                <TextBlock Classes="page-title" Text="Networks"/>
                <TextBlock Classes="page-subtitle" Text="{Binding Items.Count, StringFormat='{}{0} shown'}" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <TextBox Grid.Column="1" Classes="search" Text="{Binding SearchText}" PlaceholderText="Search networks"/>
            <Button Grid.Column="2" Classes="icon" Margin="8,0,0,0" Command="{Binding RefreshCommand}" ToolTip.Tip="Refresh">
                <c:Icon Data="{StaticResource Icon.RefreshCw}"/>
            </Button>
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="2" Margin="0,0,0,8">
                <Button Classes="ghost tint-danger"
                        IsVisible="{Binding !!SelectedCount}"
                        Content="{Binding SelectedCount, StringFormat='Remove selected ({0})'}"
                        Command="{Binding RemoveSelectedCommand}"/>
                <Button Classes="ghost" Content="Remove unused" Command="{Binding RemoveUnusedCommand}"
                        ToolTip.Tip="Remove networks no container uses (docker network prune)"/>
        </StackPanel>

        <Border Grid.Row="2" Classes="table-header">
            <Grid ColumnDefinitions="32,3*,100,80,2*,130,56" Margin="12,0">
                <Button Grid.Column="1" Classes="th" Command="{Binding SortByCommand}" CommandParameter="name">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="NAME"/>
                        <c:Icon Width="12" Height="12" VerticalAlignment="Center">
                            <c:Icon.Data>
                                <MultiBinding Converter="{x:Static conv:SortIndicatorConverter.Instance}" ConverterParameter="name">
                                    <Binding Path="SortColumn"/>
                                    <Binding Path="SortDescending"/>
                                </MultiBinding>
                            </c:Icon.Data>
                        </c:Icon>
                    </StackPanel>
                </Button>
                <Button Grid.Column="2" Classes="th" Command="{Binding SortByCommand}" CommandParameter="driver">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="DRIVER"/>
                        <c:Icon Width="12" Height="12" VerticalAlignment="Center">
                            <c:Icon.Data>
                                <MultiBinding Converter="{x:Static conv:SortIndicatorConverter.Instance}" ConverterParameter="driver">
                                    <Binding Path="SortColumn"/>
                                    <Binding Path="SortDescending"/>
                                </MultiBinding>
                            </c:Icon.Data>
                        </c:Icon>
                    </StackPanel>
                </Button>
                <Button Grid.Column="3" Classes="th" Command="{Binding SortByCommand}" CommandParameter="scope">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="SCOPE"/>
                        <c:Icon Width="12" Height="12" VerticalAlignment="Center">
                            <c:Icon.Data>
                                <MultiBinding Converter="{x:Static conv:SortIndicatorConverter.Instance}" ConverterParameter="scope">
                                    <Binding Path="SortColumn"/>
                                    <Binding Path="SortDescending"/>
                                </MultiBinding>
                            </c:Icon.Data>
                        </c:Icon>
                    </StackPanel>
                </Button>
                <TextBlock Grid.Column="4" Classes="label" Text="FLAGS" VerticalAlignment="Center"/>
                <Button Grid.Column="5" Classes="th" Command="{Binding SortByCommand}" CommandParameter="created">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="CREATED"/>
                        <c:Icon Width="12" Height="12" VerticalAlignment="Center">
                            <c:Icon.Data>
                                <MultiBinding Converter="{x:Static conv:SortIndicatorConverter.Instance}" ConverterParameter="created">
                                    <Binding Path="SortColumn"/>
                                    <Binding Path="SortDescending"/>
                                </MultiBinding>
                            </c:Icon.Data>
                        </c:Icon>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <ListBox Grid.Row="3" Classes="table" ItemsSource="{Binding Items}" SelectedItems="{Binding SelectedItems}" SelectionMode="Multiple,Toggle">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="vm:NetworkViewModel">
                    <Grid ColumnDefinitions="32,3*,100,80,2*,130,56" Margin="12,0">
                        <CheckBox Grid.Column="0" Classes="row-check" IsChecked="{Binding $parent[ListBoxItem].IsSelected, Mode=TwoWay}"/>
                        <TextBlock Grid.Column="1" Classes="cell primary" Text="{Binding Name}" ToolTip.Tip="{Binding Id}" Margin="0,0,12,0"/>
                        <TextBlock Grid.Column="2" Classes="cell" Text="{Binding Driver}"/>
                        <TextBlock Grid.Column="3" Classes="cell" Text="{Binding Scope}"/>
                        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Border Classes="pill" IsVisible="{Binding IsBuiltIn}"><TextBlock Text="built-in"/></Border>
                            <Border Classes="pill" IsVisible="{Binding Internal}"><TextBlock Text="internal"/></Border>
                            <Border Classes="pill" IsVisible="{Binding Attachable}"><TextBlock Text="attachable"/></Border>
                        </StackPanel>
                        <TextBlock Grid.Column="5" Classes="cell muted" Text="{Binding CreatedRelative}" ToolTip.Tip="{Binding Created}"/>
                        <StackPanel Grid.Column="6" Classes="row-actions" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Classes="icon tint-danger" ToolTip.Tip="Remove network" IsEnabled="{Binding IsRemovable}"
                                    Command="{Binding $parent[ListBox].((vmp:NetworksPageViewModel)DataContext).RemoveItemCommand}"
                                    CommandParameter="{Binding}">
                                <c:Icon Data="{StaticResource Icon.Trash}"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
