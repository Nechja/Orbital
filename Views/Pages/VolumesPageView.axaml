<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vmp="using:OrbitalDocking.ViewModels.Pages"
             xmlns:components="using:OrbitalDocking.Views.Components"
             xmlns:c="using:OrbitalDocking.Controls"
             x:Class="OrbitalDocking.Views.Pages.VolumesPageView"
             x:DataType="vmp:VolumesPageViewModel">

    <Grid RowDefinitions="Auto,*" Margin="32,24,32,16">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,20">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                <TextBlock Classes="page-title" Text="Volumes"/>
                <TextBlock Classes="page-subtitle" Text="{Binding Items.Count, StringFormat='{}{0} shown'}"/>
            </StackPanel>
            <TextBox Grid.Column="1" Classes="search" Text="{Binding SearchText}" PlaceholderText="Search volumes"/>
            <Button Grid.Column="2" Classes="icon" Margin="8,0,0,0"
                    Command="{Binding RefreshCommand}" ToolTip.Tip="Refresh">
                <c:Icon Data="{StaticResource Icon.RefreshCw}"/>
            </Button>
        </Grid>

        <ScrollViewer Grid.Row="1">
            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Spacing="8"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate><components:VolumeCard/></DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
