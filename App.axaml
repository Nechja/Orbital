<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vmp="using:OrbitalDocking.ViewModels.Pages"
             xmlns:pages="using:OrbitalDocking.Views.Pages"
             x:Class="OrbitalDocking.App"
             RequestedThemeVariant="Dark">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://OrbitalDocking/Themes/Palette.axaml"/>
                <ResourceInclude Source="avares://OrbitalDocking/Styles/Icons.axaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.DataTemplates>
        <DataTemplate DataType="vmp:ContainersPageViewModel"><pages:ContainersPageView/></DataTemplate>
        <DataTemplate DataType="vmp:ImagesPageViewModel"><pages:ImagesPageView/></DataTemplate>
        <DataTemplate DataType="vmp:VolumesPageViewModel"><pages:VolumesPageView/></DataTemplate>
        <DataTemplate DataType="vmp:NetworksPageViewModel"><pages:NetworksPageView/></DataTemplate>
        <DataTemplate DataType="vmp:LogsPageViewModel"><pages:LogsPageView/></DataTemplate>
        <DataTemplate DataType="vmp:SettingsPageViewModel"><pages:SettingsPageView/></DataTemplate>
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://OrbitalDocking/Styles/Controls.axaml"/>
    </Application.Styles>
</Application>
