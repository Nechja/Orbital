<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:OrbitalDocking.Controls">

    <!-- ===== Typography ===== -->
    <Style Selector="Window">
        <Setter Property="FontFamily" Value="fonts:Inter#Inter"/>
    </Style>
    <Style Selector="TextBlock.page-title">
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryColor}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="TextBlock.page-subtitle">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource TextTertiaryColor}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="TextBlock.label">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{DynamicResource TextTertiaryColor}"/>
        <Setter Property="LetterSpacing" Value="1"/>
    </Style>
    <Style Selector="TextBlock.mono">
        <Setter Property="FontFamily" Value="Consolas,Menlo,DejaVu Sans Mono,monospace"/>
    </Style>

    <!-- ===== Inputs ===== -->
    <Style Selector="TextBox">
        <Setter Property="PlaceholderForeground" Value="{DynamicResource TextTertiaryColor}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource PrimaryColor}"/>
    </Style>
    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryColor}"/>
    </Style>
    <Style Selector="TextBox.search">
        <Setter Property="Width" Value="260"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Background" Value="{DynamicResource SurfaceColor}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryColor}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="ComboBox">
        <Setter Property="PlaceholderForeground" Value="{DynamicResource TextTertiaryColor}"/>
    </Style>

    <!-- ===== Buttons ===== -->
    <Style Selector="Button.icon">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="7"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryColor}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.icon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BackgroundTertiaryColor}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryColor}"/>
    </Style>

    <Style Selector="Button.action">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.action:pointerover">
        <Setter Property="Opacity" Value="0.8"/>
    </Style>

    <Style Selector="Button.primary, Button.danger, Button.danger-dark, Button.restart, Button.accent, Button.subtle, Button.outlined">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{DynamicResource TextContrastColor}"/>
    </Style>
    <Style Selector="Button.primary:pointerover, Button.danger:pointerover, Button.danger-dark:pointerover, Button.restart:pointerover, Button.accent:pointerover">
        <Setter Property="Opacity" Value="0.9"/>
    </Style>
    <Style Selector="Button.subtle:pointerover, Button.outlined:pointerover">
        <Setter Property="Opacity" Value="0.8"/>
    </Style>
    <Style Selector="Button.primary">
        <Setter Property="Background" Value="{DynamicResource PrimaryColor}"/>
    </Style>
    <Style Selector="Button.danger">
        <Setter Property="Background" Value="{DynamicResource DangerColor}"/>
    </Style>
    <Style Selector="Button.danger-dark">
        <Setter Property="Background" Value="{DynamicResource DangerDarkColor}"/>
    </Style>
    <Style Selector="Button.restart">
        <Setter Property="Background" Value="{DynamicResource RestartColor}"/>
    </Style>
    <Style Selector="Button.accent">
        <Setter Property="Background" Value="{DynamicResource ActionAccentColor}"/>
        <Setter Property="Foreground" Value="{DynamicResource BackgroundColor}"/>
    </Style>
    <Style Selector="Button.subtle">
        <Setter Property="Background" Value="{DynamicResource CardColor}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryColor}"/>
        <Setter Property="Padding" Value="12,6"/>
    </Style>
    <Style Selector="Button.outlined">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryColor}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderInputColor}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,6"/>
    </Style>

    <!-- ===== Sidebar navigation ===== -->
    <Style Selector="ListBox.nav">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
    </Style>
    <Style Selector="ListBox.nav ListBoxItem">
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="Margin" Value="0,1"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryColor}"/>
    </Style>
    <Style Selector="ListBox.nav ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="CornerRadius" Value="6"/>
    </Style>
    <Style Selector="ListBox.nav ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BackgroundTertiaryColor}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryColor}"/>
    </Style>
    <Style Selector="ListBox.nav ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter,
                     ListBox.nav ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                     ListBox.nav ListBoxItem:selected:focus /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource CardColor}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryColor}"/>
    </Style>

    <Style Selector="Button.nav-footer">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryColor}"/>
    </Style>
    <Style Selector="Button.nav-footer:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BackgroundTertiaryColor}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryColor}"/>
    </Style>
    <Style Selector="Button.nav-footer.active /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource CardColor}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryColor}"/>
    </Style>

    <Style Selector="Border.badge">
        <Setter Property="Background" Value="{DynamicResource BackgroundTertiaryColor}"/>
        <Setter Property="CornerRadius" Value="9"/>
        <Setter Property="Padding" Value="7,1"/>
        <Setter Property="MinWidth" Value="22"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Border.badge > TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{DynamicResource TextTertiaryColor}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>

    <!-- ===== Status indicators (apply state via Classes.running="{Binding IsRunning}" etc.) ===== -->
    <Style Selector="Ellipse.state">
        <Setter Property="Width" Value="8"/>
        <Setter Property="Height" Value="8"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Fill" Value="{DynamicResource StateStoppedColor}"/>
    </Style>
    <Style Selector="Ellipse.state.running"><Setter Property="Fill" Value="{DynamicResource StateRunningColor}"/></Style>
    <Style Selector="Ellipse.state.paused"><Setter Property="Fill" Value="{DynamicResource StatePausedColor}"/></Style>
    <Style Selector="Ellipse.state.problem"><Setter Property="Fill" Value="{DynamicResource StateDeadColor}"/></Style>

    <Style Selector="TextBlock.state"><Setter Property="Foreground" Value="{DynamicResource StateStoppedColor}"/></Style>
    <Style Selector="TextBlock.state.running"><Setter Property="Foreground" Value="{DynamicResource StateRunningColor}"/></Style>
    <Style Selector="TextBlock.state.paused"><Setter Property="Foreground" Value="{DynamicResource StatePausedColor}"/></Style>
    <Style Selector="TextBlock.state.problem"><Setter Property="Foreground" Value="{DynamicResource StateDeadColor}"/></Style>

    <Style Selector="Ellipse.docker">
        <Setter Property="Width" Value="6"/>
        <Setter Property="Height" Value="6"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Fill" Value="{DynamicResource DockerOfflineColor}"/>
    </Style>
    <Style Selector="Ellipse.docker.online"><Setter Property="Fill" Value="{DynamicResource DockerOnlineColor}"/></Style>
    <Style Selector="Ellipse.docker.connecting"><Setter Property="Fill" Value="{DynamicResource DockerConnectingColor}"/></Style>
</Styles>
