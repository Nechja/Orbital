<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:OrbitalDocking.ViewModels"
        xmlns:vmp="using:OrbitalDocking.ViewModels.Pages"
        xmlns:c="using:OrbitalDocking.Controls"
        xmlns:conv="using:OrbitalDocking.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
        x:Class="OrbitalDocking.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Orbital Docking"
        Width="1280" Height="800"
        MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundColor}">

    <Grid RowDefinitions="*,Auto">
        <Grid Grid.Row="0" ColumnDefinitions="220,*">

            <!-- Sidebar -->
            <Border Grid.Column="0"
                    Background="{DynamicResource SurfaceColor}"
                    BorderBrush="{DynamicResource BorderColor}"
                    BorderThickness="0,0,1,0">
                <DockPanel Margin="12,16">
                    <TextBlock DockPanel.Dock="Top"
                               Text="Orbital"
                               FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryColor}"
                               Margin="10,0,10,20"/>

                    <Button DockPanel.Dock="Bottom"
                            Classes="nav-footer"
                            Classes.active="{Binding IsSettingsActive}"
                            Command="{Binding ShowSettingsCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <c:Icon Data="{StaticResource Icon.Settings}"/>
                            <TextBlock Text="Settings" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <ListBox Classes="nav"
                             ItemsSource="{Binding Pages}"
                             SelectedItem="{Binding SelectedNavPage}">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="vmp:PageViewModel">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <c:Icon Grid.Column="0"
                                            Data="{Binding IconKey, Converter={x:Static conv:IconKeyConverter.Instance}}"
                                            Margin="0,0,10,0"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="13" VerticalAlignment="Center"/>
                                    <Border Grid.Column="2" Classes="badge"
                                            IsVisible="{Binding Count, Converter={x:Static ObjectConverters.IsNotNull}}">
                                        <TextBlock Text="{Binding Count}"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Current page -->
            <ContentControl Grid.Column="1" Content="{Binding CurrentPage}"/>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="1"
                Background="{DynamicResource SurfaceColor}"
                BorderBrush="{DynamicResource BorderColor}"
                BorderThickness="0,1,0,0"
                Height="30">
            <Grid Margin="16,0" ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse Classes="docker"
                                 Classes.online="{Binding State.IsDockerConnected}"
                                 Classes.connecting="{Binding State.IsDockerConnecting}"/>
                        <TextBlock Text="DOCKER" Classes="label" FontSize="10" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="{Binding State.DockerVersion}"
                               FontSize="11"
                               Foreground="{DynamicResource TextSecondaryColor}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock Grid.Column="1"
                           Text="{Binding State.StatusMessage}"
                           FontSize="11"
                           Foreground="{DynamicResource TextTertiaryColor}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                    <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryColor}"
                               Text="{Binding Containers.RunningCount, StringFormat='{}{0} running'}"/>
                    <TextBlock FontSize="11" Foreground="{DynamicResource TextTertiaryColor}"
                               Text="{Binding Containers.StoppedCount, StringFormat='{}{0} stopped'}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
